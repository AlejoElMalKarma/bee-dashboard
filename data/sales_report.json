{
  "metadata": {
    "dataset": "Sales Performance Report",
    "period": "2025-Q1 to 2025-Q4",
    "kpis": [
      {
        "id": "kpi_meta",
        "name": "Tasa de Cumplimiento de Meta",
        "description": "Porcentaje de ingresos reales vs. meta asignada",
        "formula": "(revenue / target) * 100",
        "unit": "%",
        "benchmark": 100,
        "status_rules": {
          "green": ">= 100",
          "yellow": ">= 80",
          "red": "< 80"
        }
      },
      {
        "id": "kpi_conversion",
        "name": "Tasa de Conversión",
        "description": "Porcentaje de leads que se convierten en clientes",
        "formula": "(deals_closed / leads) * 100",
        "unit": "%",
        "benchmark": 25,
        "status_rules": {
          "green": ">= 25",
          "yellow": ">= 15",
          "red": "< 15"
        }
      }
    ]
  },
